# ============================================================
# MÉTRICAS
# ============================================================

metrics = {
    "mAP50": "mAP@50",
    "mAP50-95": "mAP@50-95",
    "P": "Precision",
    "R": "Recall",
    "F1": "F1-score"
}


# ============================================================
# GERAR OS GRÁFICOS
# ============================================================

for metric, metric_label in metrics.items():

    plt.figure(figsize=(11, 6.5))


    # ========================================================
    # CADA ARQUITETURA = UMA LINHA
    # ========================================================

    for family, models in data.items():

        params = []
        values = []
        labels = []

        for size, info in models.items():

            params.append(info["params"])
            values.append(info[metric])
            labels.append(size.upper())


        # ----------------------------------------------------
        # LINHA
        # ----------------------------------------------------

        plt.plot(
            params,
            values,
            marker="o",
            linewidth=2.5,
            markersize=7,
            label=family
        )


        # ----------------------------------------------------
        # NOME DO TAMANHO EM CADA PONTO
        # ----------------------------------------------------

        for px, py, label in zip(params, values, labels):

            plt.annotate(
                label,
                (px, py),
                xytext=(0, 10),
                textcoords="offset points",
                ha="center",
                fontsize=9,
                fontweight="bold"
            )


    # ========================================================
    # EIXO X
    # ========================================================

    plt.xlabel(
        "Number of parameters (M)",
        fontsize=12
    )


    # ========================================================
    # EIXO Y
    # ========================================================

    plt.ylabel(
        metric_label,
        fontsize=12
    )

    plt.ylim(
        0.60,
        1.00
    )


    # ========================================================
    # TÍTULO
    # ========================================================

    plt.title(
        f"{metric_label} vs. Number of Parameters",
        fontsize=14,
        fontweight="bold"
    )


    # ========================================================
    # GRADE
    # ========================================================

    plt.grid(
        True,
        linestyle="--",
        alpha=0.35
    )


    # ========================================================
    # LEGENDA
    # ========================================================

    plt.legend(
        fontsize=10
    )


    # ========================================================
    # AJUSTES
    # ========================================================

    plt.tight_layout()


    # ========================================================
    # SALVAR
    # ========================================================

    filename = metric.replace("-", "_")

    plt.savefig(
        f"parametros_vs_{filename}.png",
        dpi=300,
        bbox_inches="tight"
    )


    plt.show()
